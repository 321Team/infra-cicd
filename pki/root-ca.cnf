# New CA only; run with current directory at the protected CA asset root.
[ ca ]
default_ca = project_ca
[ project_ca ]
dir = .
database = $dir/index.txt
new_certs_dir = $dir/newcerts
certificate = $dir/certs/fds-root-ca.crt
private_key = $dir/private/fds-root-ca.key
serial = $dir/serial
default_md = sha256
default_days = 365
policy = server_policy
unique_subject = no
copy_extensions = none
[ server_policy ]
countryName = supplied
organizationName = supplied
organizationalUnitName = optional
commonName = supplied
[ req ]
prompt = no
default_md = sha256
distinguished_name = root_dn
x509_extensions = root_extensions
[ root_dn ]
C = KR
O = FDS
OU = Project PKI
CN = FDS Project Root CA 2026
[ root_extensions ]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
