        "timeout_seconds": 300
      },
      "contract": {
        "cwd": "fds-engine",
        "argv": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "-q",
          "tests/test_health.py"
        ],
        "timeout_seconds": 300
      }
